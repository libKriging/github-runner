# Copier en runner.env puis adapter.
# Ce fichier sert aussi aux scripts Windows (.ps1), qui comprennent
# KEY=VALUE, $HOME, $(hostname) et ${VAR}.

# Cible : un dépôt (https://github.com/OWNER/REPO) ou une organisation (https://github.com/ORG)
GITHUB_URL=https://github.com/libKriging/libKriging

# Nom du runner (unique dans le dépôt/l'organisation)
RUNNER_NAME=$(hostname)-runner

# Labels supplémentaires (self-hosted, <OS>, <arch> sont ajoutés automatiquement)
RUNNER_LABELS=libkriging

# Groupe de runners (organisations uniquement)
RUNNER_GROUP=Default

# Répertoire d'installation du runner (Linux / macOS).
# À garder HORS du dossier Sync : le runner y écrit beaucoup de fichiers (_work, _diag).
RUNNER_DIR=$HOME/.actions-runner/${RUNNER_NAME}

# Répertoire d'installation sous Windows (chemin court conseillé, limite de 260 caractères)
# RUNNER_DIR_WIN=C:\actions-runner\${RUNNER_NAME}

# Version du runner ("latest" ou ex. 2.321.0)
RUNNER_VERSION=latest

# Jeton d'API facultatif (PAT avec scope repo / admin:org). Sinon, le CLI `gh` est utilisé.
# GITHUB_PAT=
